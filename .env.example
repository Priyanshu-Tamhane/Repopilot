# LLM - Groq is primary for this project (Phase 1 baseline uses Large LLM)
LLM_MOCK=true
LLM_PROVIDER=groq  # groq | mock | openai

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (fallback / legacy)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Execution
SANDBOX_MODE=auto  # auto | docker | local
WORKDIR=C:\Users\PRIYAN~1\AppData\Local\Temp\repopilot

# API
API_HOST=0.0.0.0
API_PORT=8000

# Docker
DOCKER_IMAGE=python:3.11-slim
DOCKER_MEMORY_LIMIT=1g
DOCKER_CPU_LIMIT=1.0
